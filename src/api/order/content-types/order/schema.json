{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::customer.customer",
      "inversedBy": "orders"
    },
    "active": {
      "type": "boolean"
    },
    "firstDelivery": {
      "type": "date"
    },
    "plantsToGrow": {
      "type": "component",
      "repeatable": true,
      "component": "grow.plant-batch"
    },
    "deliveryTimes": {
      "type": "component",
      "repeatable": false,
      "component": "time.calendar-rule"
    },
    "batches": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::batch.batch",
      "mappedBy": "order"
    },
    "price_list": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::price-list.price-list",
      "inversedBy": "orders"
    },
    "batch_deliveries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::batch-delivery.batch-delivery",
      "mappedBy": "order"
    },
    "cropsToGrow": {
      "type": "component",
      "repeatable": true,
      "component": "grow.crop-batch"
    },
    "itemsForDelivery": {
      "type": "component",
      "repeatable": true,
      "component": "grow.recipe-batch"
    }
  }
}
